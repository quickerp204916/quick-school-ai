# Quick School AI intelligence service
QSA_AI_SERVICE_KEY=            # same value as QSA_AI_SERVICE_KEY in the Laravel app
QSA_ERP_ALLOWED_HOSTS=.quickschool.app   # hosts the service may call back for ERP tools
OPENAI_API_KEY=
GEMINI_API_KEY=
# Vectors for RAG: PostgreSQL 16 with pgvector (CREATE EXTENSION vector; run once by a superuser)
QSA_AI_DATABASE_URL=postgresql://qsa_ai:CHANGE_ME@127.0.0.1:5432/qsa_ai
QSA_EMBEDDING_PROVIDER=openai          # openai | gemini
QSA_EMBEDDING_MODEL=text-embedding-3-small
QSA_EMBEDDING_DIM=1536
QSA_AI_MAX_STEPS=8
