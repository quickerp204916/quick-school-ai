# Quick School AI production settings. install.sh copies this to deploy/.env, fills in the
# generated secrets and sets permissions to 600. Never commit deploy/.env.

# ---- You set these ---------------------------------------------------------------------------
# Your platform domain. DNS: an A record for BASE_DOMAIN and for *.BASE_DOMAIN pointing at the server.
BASE_DOMAIN=quickschool.app
# Let's Encrypt account e-mail (expiry notices).
ACME_EMAIL=

APP_NAME="Quick School AI"
APP_TIMEZONE=UTC
LOG_LEVEL=warning

# Seller details printed on platform invoices to schools.
PLATFORM_SELLER_NAME="Quick ERP Technologies Pvt. Ltd."
PLATFORM_SELLER_GSTIN=
PLATFORM_SELLER_STATE_CODE=09
PLATFORM_SELLER_ADDRESS=

# Outgoing mail (password resets, invoices, fee reminders). Any SMTP provider: SES, Zoho, Postmark...
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=
MAIL_FROM_ADDRESS="no-reply@quickschool.app"
MAIL_FROM_NAME="Quick School AI"

# AI providers (optional; the ERP works without them, AI features stay off).
OPENAI_API_KEY=
GEMINI_API_KEY=
QSA_EMBEDDING_PROVIDER=openai

# Only if a cloud load balancer sits in front of this server: its private IP range, e.g. 10.0.0.0/8.
# Leave empty when Caddy faces the internet directly, so clients can't spoof their IP address.
TRUSTED_PROXIES=

SESSION_LIFETIME=120
SESSION_ENCRYPT=true

# Off-site backups (optional): an rclone remote such as s3:my-bucket/qsa. Needs rclone configured on the host.
BACKUP_RCLONE_REMOTE=
BACKUP_KEEP_DAYS=14

# ---- Generated by install.sh (leave empty; existing values are kept) --------------------------
APP_KEY=
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
AI_DB_PASSWORD=
REDIS_PASSWORD=
QSA_AI_SERVICE_KEY=
