APP_NAME="Quick School AI"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

# MySQL 8.4 or PostgreSQL 16. For PostgreSQL use DB_CONNECTION=pgsql, DB_PORT=5432, and a role that is
# not a superuser and does not have BYPASSRLS (Row-Level Security does not apply to those).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=quick_school_ai
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false

CACHE_STORE=database
QUEUE_CONNECTION=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@quickschool.app"
MAIL_FROM_NAME="Quick School AI"

# Super Admin module
PLATFORM_BASE_DOMAIN=quickschool.app
PLATFORM_SELLER_NAME="Quick ERP Technologies Pvt. Ltd."
PLATFORM_SELLER_GSTIN=
PLATFORM_SELLER_STATE_CODE=09
PLATFORM_SELLER_ADDRESS=

# Institution app: subdomain ({code}.quickschool.app) in production, path (/i/{code}) for local development
TENANT_ROUTING=subdomain

# Optional: first super admin created by `php artisan db:seed`
PLATFORM_ADMIN_NAME=
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=

# AI Intelligence Engine (ai-service/). Use the same long random key on both sides; the AI service holds the OpenAI/Gemini keys.
QSA_AI_SERVICE_URL=http://127.0.0.1:8090
QSA_AI_SERVICE_KEY=
